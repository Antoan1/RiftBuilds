@model IEnumerable<RiftBuilds.Models.Champion>

@{
    ViewData["Title"] = "Champions";
}

<h1 class="mb-4">Champions</h1>

@if (!Model.Any())
{
    <p>No champions available.</p>
}
else
{
    <div class="row g-4">
        @foreach (var champion in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <img src="@champion.ImageUrl"
                         class="card-img-top"
                         alt="@champion.Name" />

                    <div class="card-body">
                        <h2 class="card-title h4">@champion.Name</h2>
                        <p class="card-text">@champion.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
}