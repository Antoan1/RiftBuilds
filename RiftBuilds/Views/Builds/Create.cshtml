@model RiftBuilds.ViewModels.Builds.BuildFormViewModel
@using RiftBuilds.Models.Enums

@{
    ViewData["Title"] = "Create Build";
}

<h1 class="mb-4">Create Build</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-controller="Builds" asp-action="Create" method="post">
            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ChampionId" class="form-label">
                    Champion
                </label>
                <select asp-for="ChampionId"
                        asp-items="Model.Champions"
                        class="form-select">
                    <option value="">Choose a champion</option>
                </select>
                <span asp-validation-for="ChampionId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Position" class="form-label"></label>
                <select asp-for="Position"
                        asp-items="Html.GetEnumSelectList<Position>()"
                        class="form-select">
                    <option value="">Choose a position</option>
                </select>
                <span asp-validation-for="Position"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SelectedItemIds" class="form-label">
                    Items
                </label>
                <select asp-for="SelectedItemIds"
                        asp-items="Model.Items"
                        class="form-select"
                        multiple
                        size="8"
                        aria-describedby="items-help">
                </select>
                <div id="items-help" class="form-text">
                    Select between 1 and 6 items.
                    Hold Ctrl on Windows to select multiple items.
                </div>
                <span asp-validation-for="SelectedItemIds"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create Build
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}