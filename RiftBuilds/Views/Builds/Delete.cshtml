@model RiftBuilds.ViewModels.Builds.BuildDetailsViewModel

@{
    ViewData["Title"] = "Delete Build";
}

<h1 class="mb-4">Delete Build</h1>

<div class="alert alert-warning" role="alert">
    Are you sure you want to delete this build?
    This action cannot be undone.
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h4">@Model.Title</h2>

        <p>
            <strong>Champion:</strong> @Model.ChampionName
        </p>

        <p>
            <strong>Position:</strong> @Model.Position
        </p>

        <p class="text-break">@Model.Description</p>

        <p class="mb-0">
            <strong>Items:</strong> @Model.Items.Count
        </p>
    </div>
</div>

<form asp-controller="Builds"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-controller="Builds"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">
        Cancel
    </a>
</form>