@model RiftBuilds.ViewModels.Builds.BuildFormViewModel

<fieldset class="mb-3">
    <legend class="fs-6">Items</legend>

    <p id="items-help" class="form-text">
        Select between 1 and 6 items.
    </p>

    <div class="row g-2">
        @foreach (var item in Model.Items)
        {
            var isSelected = Model.SelectedItemIds?
            .Contains(item.Id) == true;

            <div class="col-12 col-sm-6">
                <div class="item-option">
                    <input type="checkbox"
                           class="item-option-input"
                           id="item-@item.Id"
                           name="SelectedItemIds"
                           value="@item.Id"
                           checked="@isSelected"
                           aria-describedby="items-help" />

                    <label class="item-option-label"
                           for="item-@item.Id">
                        <img src="@item.ImageUrl"
                             alt=""
                             width="48"
                             height="48" />

                        <span>@item.Name</span>
                    </label>
                </div>
            </div>
        }
    </div>

    <span asp-validation-for="SelectedItemIds"
          class="text-danger"></span>
</fieldset>