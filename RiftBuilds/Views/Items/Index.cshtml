@model RiftBuilds.ViewModels.Items.ItemQueryViewModel

@{
    ViewData["Title"] = "Items";
}

<h1 class="mb-4">Items</h1>

<form asp-area=""
      asp-controller="Items"
      asp-action="Index"
      method="get"
      class="card mb-4">

    <div class="card-body">
        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <label asp-for="SearchTerm" class="form-label"></label>
                <input asp-for="SearchTerm"
                       class="form-control"
                       placeholder="Enter an item name"
                       maxlength="50" />
                <span asp-validation-for="SearchTerm"
                      class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="MinPrice" class="form-label"></label>
                <input asp-for="MinPrice"
                       class="form-control"
                       type="number"
                       min="0"
                       step="1"
                       placeholder="No minimum" />
                <span asp-validation-for="MinPrice"
                      class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="MaxPrice" class="form-label"></label>
                <input asp-for="MaxPrice"
                       class="form-control"
                       type="number"
                       min="0"
                       step="1"
                       placeholder="No maximum" />
                <span asp-validation-for="MaxPrice"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-area=""
               asp-controller="Items"
               asp-action="Index"
               class="btn btn-secondary">
                Clear Filters
            </a>
        </div>
    </div>
</form>

@if (ViewData.ModelState.IsValid)
{
    <p class="text-muted">
        Results: @Model.TotalItems
    </p>

    @if (!Model.Items.Any())
    {
        <p>No items match your search. Try changing or clearing the filters.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 width="64"
                                 height="64"
                                 class="mb-3" />

                            <h2 class="card-title h4">@item.Name</h2>

                            <p class="card-text text-break">
                                @item.Description
                            </p>

                            <p class="fw-bold mb-0">
                                Price: @item.Price gold
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Item pages" class="mt-4">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-area=""
                           asp-controller="Items"
                           asp-action="Index"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-MinPrice="@Model.MinPrice"
                           asp-route-MaxPrice="@Model.MaxPrice"
                           asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                           class="btn btn-secondary"
                           rel="prev">
                            Previous
                        </a>
                    }

                    <span>
                        Page @Model.CurrentPage of @Model.TotalPages
                    </span>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-area=""
                           asp-controller="Items"
                           asp-action="Index"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-MinPrice="@Model.MinPrice"
                           asp-route-MaxPrice="@Model.MaxPrice"
                           asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                           class="btn btn-secondary"
                           rel="next">
                            Next
                        </a>
                    }
                </div>
            </nav>
        }
    }
}

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}