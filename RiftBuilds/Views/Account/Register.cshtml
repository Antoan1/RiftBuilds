@model RiftBuilds.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<h1 class="mb-4">Create an account</h1>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email"
                       class="form-control"
                       autocomplete="email" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>

                <div class="input-group">
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-describedby="password-help" />

                    <button type="button"
                            class="btn btn-secondary"
                            data-password-toggle="Password"
                            aria-controls="Password"
                            aria-label="Show password"
                            aria-pressed="false">
                        Show
                    </button>
                </div>

                <div id="password-help" class="form-text">
                    Use 8–100 characters, including an uppercase letter,
                    a lowercase letter, a number, and a special character.
                </div>

                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword"
                       class="form-label"></label>

                <div class="input-group">
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <button type="button"
                            class="btn btn-secondary"
                            data-password-toggle="ConfirmPassword"
                            aria-controls="ConfirmPassword"
                            aria-label="Show password confirmation"
                            aria-pressed="false">
                        Show
                    </button>
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Register
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>

        <p class="mt-4">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">
                Login
            </a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}