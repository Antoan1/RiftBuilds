@{
    ViewData["Title"] = "Privacy";
}

<h1 class="mb-4">Privacy</h1>

<div class="row">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body">
                <h2 class="h4">About this project</h2>
                <p>
                    RiftBuilds is an educational application for creating
                    and exploring League of Legends builds.
                    This version does not offer user accounts or require
                    an email address.
                </p>

                <h2 class="h4 mt-4">Information you submit</h2>
                <p>
                    When you create a build, the application stores its
                    title, description, selected champion, position,
                    items, and creation date in its database.
                </p>
                <p>
                    Do not include personal or sensitive information
                    in build titles or descriptions.
                </p>

                <h2 class="h4 mt-4">Shared builds</h2>
                <p>
                    Builds are shared content. Anyone with access to this
                    application can view, edit, or delete them.
                    Builds are not linked to individual owners.
                </p>

                <h2 class="h4 mt-4">Technical cookies</h2>
                <p>
                    The application uses technical cookies to help protect
                    submitted forms against forged requests and to display
                    temporary messages after actions such as saving a build.
                </p>
                <p>
                    This version does not include advertising or
                    analytics tracking.
                </p>

                <h2 class="h4 mt-4">Deleting a build</h2>
                <p class="mb-0">
                    To remove a build, open its Details page, select
                    Delete, and confirm the action. This removes the build
                    and its item selections from the application's database.
                    Champions and items remain available in the catalog.
                </p>
            </div>
        </div>
    </div>
</div>