@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="mb-4">Admin Dashboard</h1>

<div class="card">
    <div class="card-body">
        <h2 class="h4">Welcome, Administrator!</h2>

        <p class="text-muted">
            Manage the champions and items available in RiftBuilds.
        </p>

        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Admin"
               asp-controller="Champions"
               asp-action="Index"
               class="btn btn-primary">
                Manage Champions
            </a>

            <a asp-area="Admin"
               asp-controller="Items"
               asp-action="Index"
               class="btn btn-primary">
                Manage Items
            </a>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Home
            </a>
        </div>
    </div>
</div>