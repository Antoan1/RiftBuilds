@model RiftBuilds.ViewModels.Champions.ChampionFormViewModel

@{
    ViewData["Title"] = "Add Champion";
}

<h1 class="mb-4">Add Champion</h1>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-area="Admin"
              asp-controller="Champions"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl"
                       class="form-control"
                       placeholder="/images/champions/ahri.jpg"
                       aria-describedby="image-help" />

                <div id="image-help" class="form-text">
                    Place the image in wwwroot/images/champions,
                    then enter its path, for example:
                    /images/champions/ahri.jpg
                </div>

                <span asp-validation-for="ImageUrl"
                      class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    Add Champion
                </button>

                <a asp-area="Admin"
                   asp-controller="Champions"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}