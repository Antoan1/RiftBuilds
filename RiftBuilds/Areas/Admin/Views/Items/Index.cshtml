@model IEnumerable<RiftBuilds.Models.Item>

@{
    ViewData["Title"] = "Manage Items";
}

<h1 class="mb-4">Manage Items</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-area="Admin"
       asp-controller="Items"
       asp-action="Create"
       class="btn btn-primary">
        Add Item
    </a>

    <a asp-area="Admin"
       asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>
</div>

@if (!Model.Any())
{
    <p>No items have been added yet.</p>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <img src="@item.ImageUrl"
                             alt="@item.Name"
                             width="64"
                             height="64"
                             class="rounded mb-3" />

                        <h2 class="card-title h4">@item.Name</h2>

                        <p class="card-text text-break">
                            @item.Description
                        </p>

                        <p>
                            <strong>Price:</strong> @item.Price gold
                        </p>

                        <a asp-area="Admin"
                           asp-controller="Items"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-primary">
                            Edit
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}