@model RiftBuilds.ViewModels.Items.ItemDeleteViewModel

@{
    ViewData["Title"] = "Delete Item";
}

<h1 class="mb-4">Delete Item</h1>

<div asp-validation-summary="All"
     class="text-danger mb-3"></div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card mb-4">
            <div class="card-body">
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     width="64"
                     height="64"
                     class="rounded mb-3" />

                <h2 class="h4">@Model.Name</h2>

                <p>
                    <strong>Price:</strong> @Model.Price gold
                </p>

                <p class="mb-0">
                    <strong>Used in builds:</strong> @Model.BuildsCount
                </p>
            </div>
        </div>

        @if (Model.CanDelete)
        {
            <div class="alert alert-warning" role="alert">
                Are you sure you want to delete this item?
                This action cannot be undone.
            </div>

            <form asp-area="Admin"
                  asp-controller="Items"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Items"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                This item cannot be deleted because it is used
                in one or more builds.
            </div>

            <a asp-area="Admin"
               asp-controller="Items"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Items
            </a>
        }
    </div>
</div>