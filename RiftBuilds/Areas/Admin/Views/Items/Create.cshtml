@model RiftBuilds.ViewModels.Items.ItemFormViewModel

@{
    ViewData["Title"] = "Add Item";
}

<h1 class="mb-4">Add Item</h1>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-area="Admin"
              asp-controller="Items"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       min="0"
                       step="1" />
                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl"
                       class="form-control"
                       placeholder="/images/items/black-cleaver.png"
                       aria-describedby="image-help" />

                <div id="image-help" class="form-text">
                    Enter the path to an existing item image,
                    for example: /images/items/black-cleaver.png
                </div>

                <span asp-validation-for="ImageUrl"
                      class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    Add Item
                </button>

                <a asp-area="Admin"
                   asp-controller="Items"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}